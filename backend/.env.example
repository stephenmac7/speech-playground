# Backend configuration for Speech Playground
# Copy this file to .env and adjust as needed.

# Paths can be relative to the backend/ directory or absolute.

#################################################
# --- Mandatory settings (YOU MUST SET THESE) ---
# Named directories served by the /data/{filename} endpoint (restricted to .wav
# files), as comma-separated name=path entries. The first segment of a requested
# path selects the root, so with the example below /data/samples/hello.wav
# serves samples/hello.wav and /data/public_html/x-y-01.wav would serve
# /home/USER/public_html/x-y-01.wav.
DATA_ROOTS=samples=samples
# DATA_ROOTS=samples=samples,public_html=/home/USER/public_html

###########################
# --- Optional settings ---
# Device for the encoders. Defaults to cuda when available, otherwise cpu.
# Set to cpu to test the non-CUDA path on a GPU machine.
# DEVICE=cpu

# Path to the Kanade models configuration file
KANADE_MODELS_PATH=kanade_models.json

# Path to pre-trained K-Means models for HuBERT
# HUBERT_KMEANS_PATH=/path/to/kmeans/models
# WAVLM_BASE_PLUS_KMEANS_PATH=/path/to/kmeans/models

# Training Articulatory Inversion Models for Interspeaker Consistency (McGhee et al.)
# (https://www.isca-archive.org/interspeech_2025/mcghee25_interspeech.html)
#
# Base directory with resources for articulatory inversion encoder
# INVERSION_TOP=/path/to/ume_erj

# Optional: override derived inversion paths (otherwise derived from INVERSION_TOP)
# INVERSION_WEIGHTS_PATH=/path/to/checkpoints/inversion/wavlm_baseplus_inversion_distilled
# INVERSION_MU_PATH=/path/to/normalising_vectors/JW13_mean_EMA.npy
# INVERSION_STD_PATH=/path/to/normalising_vectors/JW13_std_EMA.npy

# PhoneModel artifact for the SPAM encoders (HF repo id, local dir, or model.pt path)
# PHONEMODEL_PATH=juice500/wavlm-24-phonemodel
